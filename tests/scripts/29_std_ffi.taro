// Std module tests — FFI (Foreign Function Interface)

// === 1. Import std/ffi ===
print("=== import std/ffi ===");
import "std/ffi";
print(ffi);                       // module instance

// === 2. dlopen — load libm ===
print("=== dlopen libm ===");
var lib = ffi.dlopen("libm.so.6");
print(lib);                       // library handle
print(lib != nil);                // true

// === 3. dlsym — get cos function ===
print("=== dlsym cos ===");
var cos = ffi.dlsym(lib, "cos");
print(cos);                       // pointer address (integer)
print(cos != 0);                  // true

// === 4. call — cos(0.0) ===
print("=== call cos(0.0) ===");
var r = ffi.call(cos, "double", ["double"], [0.0]);
print(r);                         // 1.0

// === 5. call — cos(pi) ===
print("=== call cos(pi) ===");
var r2 = ffi.call(cos, "double", ["double"], [3.141592653589793]);
print(r2);                        // ~-1.0

// === 6. call — libc abs(int) ===
print("=== call libc abs ===");
var libc = ffi.dlopen("libc.so.6");
var abs_fn = ffi.dlsym(libc, "abs");
var a = ffi.call(abs_fn, "int32", ["int32"], [-42]);
print(a);                         // 42

// === 7. call — void return ===
print("=== call void fn ===");
var srand = ffi.dlsym(libc, "srand");
var v = ffi.call(srand, "void", ["uint32"], [12345]);
print(v);                         // nil

// === 8. cleanup ===
print("=== cleanup ===");
ffi.dlclose(lib);
ffi.dlclose(libc);
print("done");
