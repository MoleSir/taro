// Std module tests — json (encode / decode)

// === 1. Import std/json ===
print("=== import std/json ===");
import "std/json";
print(json);                     // module instance

// === 2. encode: nil, bool ===
print("=== encode nil / bool ===");
print(json.encode(nil) == "null");         // true
print(json.encode(true) == "true");        // true
print(json.encode(false) == "false");      // true

// === 3. encode: numbers ===
print("=== encode numbers ===");
print(json.encode(42) == "42");            // true
print(json.encode(-7) == "-7");            // true
print(json.encode(3.14) == "3.14");        // true

// === 4. encode: string ===
print("=== encode string ===");
print(json.encode("hello") == "\"hello\"");         // true
print(json.encode("a\nb") == "\"a\\nb\"");          // true
print(json.encode("say \"hi\"") == "\"say \\\"hi\\\"\""); // true

// === 5. encode: list ===
print("=== encode list ===");
print(json.encode([1, 2, 3]) == "[1,2,3]");              // true
print(json.encode(["a", 1, true]) == "[\"a\",1,true]");  // true

// === 6. encode: dict ===
print("=== encode dict ===");
var d = dict();
d["name"] = "taro";
d["version"] = 1;
var s = json.encode(d);
// Dict key order may vary — check both orderings.
print(s == "{\"name\":\"taro\",\"version\":1}"
   or s == "{\"version\":1,\"name\":\"taro\"}");          // true

// === 7. encode: nested ===
print("=== encode nested ===");
var v = [1, [2, [3, 4]], {"k": [5, 6]}];
print(json.encode(v) == "[1,[2,[3,4]],{\"k\":[5,6]}]");  // true

// === 8. decode: null, bool, numbers ===
print("=== decode scalars ===");
print(json.decode("null") == nil);              // true
print(json.decode("true") == true);             // true
print(json.decode("false") == false);           // true
print(json.decode("42") == 42);                 // true
print(json.decode("3.14") == 3.14);             // true
print(json.decode("-100") == -100);             // true

// === 9. decode: string ===
print("=== decode string ===");
print(json.decode("\"hello\"") == "hello");     // true
print(json.decode("\"a\\nb\"") == "a\nb");      // true
print(json.decode("\"\\u0041\"") == "A");       // true (Unicode escape)

// === 10. decode: array ===
print("=== decode array ===");
var a = json.decode("[1, 2, 3]");
print(len(a) == 3);                             // true
print(a[0] == 1);                               // true
print(a[1] == 2);                               // true
print(a[2] == 3);                               // true

// === 11. decode: object ===
print("=== decode object ===");
var obj = json.decode("{\"x\": 10, \"y\": 20}");
print(obj["x"] == 10);                          // true
print(obj["y"] == 20);                          // true

// === 12. decode: nested ===
print("=== decode nested ===");
var nested = json.decode("{\"items\": [1, {\"nested\": true}]}");
print(nested["items"][0] == 1);                 // true
print(nested["items"][1]["nested"] == true);    // true

// === 13. roundtrip ===
print("=== roundtrip ===");
var original = dict();
original["a"] = 1;
original["b"] = [2, 3];
original["c"] = dict();
original["c"]["d"] = "hello";
original["c"]["e"] = true;

var encoded = json.encode(original);
var decoded = json.decode(encoded);
print(decoded["a"] == 1);                       // true
print(decoded["b"][1] == 3);                    // true
print(decoded["c"]["d"] == "hello");            // true
print(decoded["c"]["e"] == true);               // true

// === 14. Import as expression ===
print("=== import as expression ===");
import "std/json" as m;
print(m.decode("[1,2,3]") != nil);              // true

// === 15. decode file ===
import "std/fs";
var context = fs.read(".vscode/settings.json");
var settings = m.decode(context);

print(settings["rust-analyzer.cargo.features"][0]);

print("done");
