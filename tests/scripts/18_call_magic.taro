// __call__ magic method — Python-style callable instances
print("=== basic __call__ ===");

class Adder {
    fun __init__(self, n) {
        self.n = n;
    }
    fun __call__(self, x) {
        return self.n + x;
    }
}
var add5 = Adder(5);
print(add5(3));    // 8
print(add5(10));   // 15

// === no argument ===
print("=== no argument ===");
class Logger {
    fun __call__(self) {
        return "logged";
    }
}
var log = Logger();
print(log());   // logged

// === multiple arguments ===
print("=== multiple args ===");
class Multiplier {
    fun __init__(self, factor) {
        self.factor = factor;
    }
    fun __call__(self, a, b) {
        return self.factor * a * b;
    }
}
var triple = Multiplier(3);
print(triple(4, 5));   // 60

// === chained calls ===
print("=== chained ===");
class Factory {
    fun __init__(self, n) {
        self.n = n;
    }
    fun __call__(self, x) {
        return self.n + x;
    }
}
print(Factory(10)(5));   // 15

// === stateful callable ===
print("=== stateful ===");
class Counter {
    fun __init__(self) {
        self.count = 0;
    }
    fun __call__(self) {
        self.count = self.count + 1;
        return self.count;
    }
    fun reset(self) {
        self.count = 0;
    }
}
var c = Counter();
print(c());  // 1
print(c());  // 2
print(c());  // 3
c.reset();
print(c());  // 1

// === callable stored in data structure ===
print("=== in list ===");
class Greeter {
    fun __init__(self, name) {
        self.name = name;
    }
    fun __call__(self) {
        return "Hello, " + self.name;
    }
}
var callbacks = [Greeter("Taro"), Greeter("World")];
print(callbacks[0]());  // Hello, Taro
print(callbacks[1]());  // Hello, World

// === callable as method return value ===
print("=== method returning callable ===");
class Creator {
    fun make_adder(self, n) {
        return Adder(n);
    }
}
var creator = Creator();
var add10 = creator.make_adder(10);
print(add10(7));  // 17

// === inherited __call__ ===
print("=== inherited __call__ ===");
class BaseCallable {
    fun __call__(self, x) {
        return x + 1;
    }
}
class ChildCallable extends BaseCallable {}
var cc = ChildCallable();
print(cc(10));  // 11

// === __call__ with self mutation ===
print("=== self mutation ===");
class Accumulator {
    fun __init__(self) {
        self.total = 0;
    }
    fun __call__(self, n) {
        self.total = self.total + n;
        return self.total;
    }
}
var acc = Accumulator();
print(acc(5));   // 5
print(acc(3));   // 8
print(acc(2));   // 10

print("__call__ done");
