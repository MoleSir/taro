// Parent class method calls via explicit class-qualified syntax
// (taro uses `ParentClass.method(self, args)` instead of `super.method(args)`)

// === 1. Basic parent call ===
print("=== basic parent method call ===");
class Base {
    fun value(self) {
        return 42;
    }
}
class Derived extends Base {
    fun value(self) {
        return 99;
    }
    fun call_parent(self) {
        return Base.value(self);
    }
}
var d = Derived();
print(d.value());        // 99 — overridden
print(d.call_parent());  // 42 — parent class method

// === 2. Parent call with arguments ===
print("=== parent call with args ===");
class Greeter {
    fun greet(self, msg) {
        print(msg);
    }
}
class QuietGreeter extends Greeter {
    fun greet(self, msg) {
        // override that does nothing
    }
    fun test(self) {
        Greeter.greet(self, "hello from base");
    }
}
QuietGreeter().test();

// === 3. Multi-level inheritance ===
print("=== multi-level ===");
class A {
    fun name(self) { return "A"; }
}
class B extends A {
    fun name(self) { return "B"; }
}
class C extends B {
    fun name(self) { return "C"; }
    fun parent_name(self) {
        return B.name(self);
    }
}
print(C().name());         // "C"
print(C().parent_name());  // "B", not "A"

// === 4. Parent __init__ call ===
print("=== parent __init__ call ===");
class Animal {
    fun __init__(self, name) {
        self.name = name;
    }
}
class Dog extends Animal {
    fun __init__(self, name, breed) {
        Animal.__init__(self, name);
        self.breed = breed;
    }
}
var dog = Dog("Buddy", "Golden");
print(dog.name);   // Buddy
print(dog.breed);  // Golden

// === 5. Parent call with multiple args ===
print("=== parent multiple args ===");
class Math {
    fun sum(self, a, b, c) {
        return a + b + c;
    }
}
class SubMath extends Math {
    fun sum(self, a, b, c) {
        // delegate to parent
        return Math.sum(self, a, b, c);
    }
}
print(SubMath().sum(1, 2, 3));  // 6

// === 6. Parent call with extra work ===
print("=== parent with extra work ===");
class Writer {
    fun write(self, text) {
        print("base: " + text);
    }
}
class FancyWriter extends Writer {
    fun write(self, text) {
        print("--- fancy start ---");
        Writer.write(self, text);
        print("--- fancy end ---");
    }
}
FancyWriter().write("hello");

// === 7. Calling parent __bool__ ===
print("=== parent __bool__ ===");
class Truthy {
    fun __bool__(self) {
        return true;
    }
}
class AlwaysFalse extends Truthy {
    fun __bool__(self) {
        return false;
    }
    fun parent_bool(self) {
        return Truthy.__bool__(self);
    }
}
print(AlwaysFalse().parent_bool());  // true (from parent)

print("parent calls done");
